<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AOI.Ui.Avalonia.MainWindow"
        Title="AOI Vision Platform | SIM_ONLY Operator Workspace"
        Width="1920" Height="1080" MinWidth="1250" MinHeight="760"
        WindowStartupLocation="CenterScreen" Background="#EDF2F8">
  <Window.Styles>
    <Style Selector="Button.nav">
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Padding" Value="15,11"/>
      <Setter Property="Margin" Value="0,3"/>
      <Setter Property="Background" Value="#244561"/>
      <Setter Property="Foreground" Value="#EAF4FF"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="Button.station.focused">
      <Setter Property="Background" Value="#C9EAF8"/>
      <Setter Property="BorderBrush" Value="#167EAD"/>
    </Style>
    <Style Selector="Button.station">
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="Foreground" Value="#183954"/>
      <Setter Property="BorderBrush" Value="#87ABC8"/>
      <Setter Property="BorderThickness" Value="2"/>
      <Setter Property="Padding" Value="9,8"/>
    </Style>
  </Window.Styles>
  <Grid RowDefinitions="Auto,*" Margin="14" RowSpacing="12">
    <Border Grid.Row="0" Padding="22,14" Background="#142C46" CornerRadius="12">
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="24">
        <StackPanel Spacing="2">
          <TextBlock Text="AOI VISION PLATFORM" Foreground="#FFFFFF" FontSize="24" FontWeight="Bold"/>
          <TextBlock Text="双机检测生产工作台  /  11 逻辑通道 · 9 物理设备 · SIM_ONLY" Foreground="#B4D0E7" FontSize="12"/>
        </StackPanel>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
          <TextBlock Text="{Binding NodeLabel}" HorizontalAlignment="Right" Foreground="#FFFFFF" FontSize="16" FontWeight="Bold"/>
          <TextBlock Text="{Binding ConnectionState}" HorizontalAlignment="Right" Foreground="#B6D2E4" FontSize="12"/>
        </StackPanel>
        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2" MaxWidth="320">
          <TextBlock Text="{Binding ProductionState}" Foreground="#D4E9F8" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right"/>
          <TextBlock Text="{Binding SafetyStatus}" Foreground="#FFD1A6" FontSize="12" TextWrapping="Wrap" HorizontalAlignment="Right"/>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="1" ColumnDefinitions="206,*" ColumnSpacing="12">
      <Border Grid.Column="0" Background="#183753" CornerRadius="11" Padding="13">
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="15">
          <StackPanel Spacing="6">
            <TextBlock Text="操作导航" Foreground="White" FontSize="17" FontWeight="SemiBold" Margin="8,6"/>
            <Button Classes="nav" Content="01   生产总览" Command="{Binding NavigateWorkspaceCommand}" CommandParameter="0"/>
            <Button Classes="nav" Content="02   整机设备地图" Command="{Binding NavigateWorkspaceCommand}" CommandParameter="1"/>
            <Button Classes="nav" Content="03   11 路图集" Command="{Binding NavigateWorkspaceCommand}" CommandParameter="2"/>
            <Button Classes="nav" Content="04   历史 / HOLD" Command="{Binding NavigateWorkspaceCommand}" CommandParameter="3"/>
            <Button Classes="nav" Content="05   PLC 工程" Command="{Binding NavigateWorkspaceCommand}" CommandParameter="4"/>
            <Button Classes="nav" Content="06   产品方案 / ROI" Command="{Binding NavigateWorkspaceCommand}" CommandParameter="5"/>
            <Button Classes="nav" Content="07   生产日报 / 周报" Command="{Binding NavigateWorkspaceCommand}" CommandParameter="6"/>
          </StackPanel>
          <StackPanel Grid.Row="2" Spacing="10">
            <Border Background="#29516E" CornerRadius="8" Padding="11">
              <StackPanel Spacing="6">
                <TextBlock Text="当前浏览" Foreground="#C2D8EB" FontSize="12"/>
                <TextBlock Text="{Binding ViewedWorkpieceLabel}" Foreground="White" FontSize="11" TextWrapping="Wrap"/>
                <Button Command="{Binding FollowLiveCommand}" Content="返回实时工件" HorizontalAlignment="Stretch"/>
              </StackPanel>
            </Border>
            <TextBlock Text="仅使用 Core IPC 状态和已验证 PNG；不连接真实 PLC / 相机。" Foreground="#AEC6D9"
                       TextWrapping="Wrap" FontSize="11"/>
          </StackPanel>
        </Grid>
      </Border>
      <TabControl Grid.Column="1" SelectedIndex="{Binding SelectedWorkspaceIndex, Mode=TwoWay}"
                  Background="Transparent" BorderThickness="0" Padding="0">
        <TabItem Header="总览">
          <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10" Margin="4">
            <Grid ColumnDefinitions="1.15*,1*" ColumnSpacing="12">
              <Border Background="White" CornerRadius="10" Padding="16">
                <StackPanel Spacing="8">
                  <TextBlock Text="实时生产 / 生产计数" FontSize="18" FontWeight="SemiBold" Foreground="#214460"/>
                  <TextBlock Text="{Binding ProductionCounters}" FontSize="15" FontWeight="SemiBold" Foreground="#17779B" TextWrapping="Wrap"/>
                  <TextBlock Text="{Binding LatestIdentity}" FontSize="11" Foreground="#536D83" TextWrapping="Wrap"/>
                  <TextBlock Text="{Binding HistoryNote}" FontSize="11" Foreground="#77879B"/>
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="16">
                <StackPanel Spacing="8">
                  <TextBlock Text="当前方案 / 生产状态" FontSize="18" FontWeight="SemiBold" Foreground="#214460"/>
                  <TextBlock Text="{Binding ActiveProductLabel}" Foreground="#1A678E" FontSize="13" TextWrapping="Wrap"/>
                  <TextBlock Text="{Binding ActiveProductRelease}" Foreground="#61778B" FontSize="11" TextWrapping="Wrap"/>
                  <TextBlock Text="{Binding HoldNotice}" Foreground="#A04A2C" FontSize="11" TextWrapping="Wrap"/>
                </StackPanel>
              </Border>
            </Grid>
            <Grid Grid.Row="1" ColumnDefinitions="1.25*,1*" ColumnSpacing="12">
              <Border Background="White" CornerRadius="10" Padding="15">
                <Grid RowDefinitions="Auto,*" RowSpacing="8">
                  <TextBlock Text="11 路相机在线状态 · 点击进入地图定位" FontSize="16" FontWeight="SemiBold" Foreground="#1F4260"/>
                  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ListBox ItemsSource="{Binding Channels}" SelectedItem="{Binding SelectedChannel, Mode=TwoWay}"
                             BorderThickness="0" Background="Transparent">
                      <ListBox.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate>
                      </ListBox.ItemsPanel>
                      <ListBox.ItemTemplate>
                        <DataTemplate>
                          <Border Margin="4" Padding="13" Background="#F2F7FC" CornerRadius="8"
                                  BorderBrush="#D9E5F0" BorderThickness="1" MinHeight="122">
                            <StackPanel Spacing="6">
                              <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{Binding ChannelId}" FontSize="21" FontWeight="Bold" Foreground="#244966"/>
                                <TextBlock Grid.Column="1" Text="{Binding Owner}" FontSize="10" Foreground="#7A92A4"/>
                              </Grid>
                              <TextBlock Text="{Binding StationDetails}" FontSize="10" Foreground="#506982"
                                         TextTrimming="CharacterEllipsis"/>
                              <TextBlock Text="{Binding State}" FontSize="11" FontWeight="SemiBold" Foreground="#247695"/>
                              <TextBlock Text="{Binding Details}" FontSize="10" Foreground="#8495A7"
                                         TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </ScrollViewer>
                </Grid>
              </Border>
              <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="16">
                <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">
                  <TextBlock Text="当前通道 / 原始 PNG 预览" FontSize="16" FontWeight="SemiBold" Foreground="#1F4260"/>
                  <TextBlock Grid.Row="1" Text="{Binding SelectedDescription}" FontSize="12" Foreground="#4D6A85" TextWrapping="Wrap"/>
                  <Border Grid.Row="2" Background="#122C42" CornerRadius="9" Padding="10">
                    <Image Source="{Binding SelectedPreview}" Stretch="Uniform"/>
                  </Border>
                  <StackPanel Grid.Row="3" Spacing="9">
                    <TextBlock Text="{Binding PreviewNotice}" Foreground="#54758F" FontSize="11" TextWrapping="Wrap"/>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="7">
                      <Button Content="设备地图 / ROI" Command="{Binding NavigateWorkspaceCommand}" CommandParameter="1"/>
                      <Button Grid.Column="1" Content="打开 11 路图集" Command="{Binding NavigateWorkspaceCommand}" CommandParameter="2"/>
                    </Grid>
                  </StackPanel>
                </Grid>
              </Border>
            </Grid>
            <Border Grid.Row="2" Background="White" CornerRadius="9" Padding="11">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <TextBlock Text="最近工件 · 点击打开 11 路图集" VerticalAlignment="Center"
                           FontWeight="SemiBold" FontSize="12" Foreground="#244765"/>
                <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled" MaxHeight="100">
                  <ListBox ItemsSource="{Binding RecentWorkpieces}"
                           SelectedItem="{Binding SelectedHistoryItem, Mode=TwoWay}"
                           BorderThickness="0" Background="Transparent">
                    <ListBox.ItemsPanel>
                      <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6"/></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <StackPanel Spacing="3" Background="#EFF5FB" MinWidth="153" Margin="2">
                          <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding ShortId}" FontSize="12" FontWeight="Bold"/>
                            <TextBlock Grid.Column="1" Text="{Binding Decision}" FontSize="10" Foreground="#267C9A"/>
                          </Grid>
                          <TextBlock Text="{Binding Barcode}" FontSize="10" TextTrimming="CharacterEllipsis"/>
                          <TextBlock Text="{Binding Channels}" FontSize="10" Foreground="#6C8499"/>
                        </StackPanel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </ScrollViewer>
                <Button Grid.Column="2" Content="实时跟随" Command="{Binding FollowLiveCommand}" VerticalAlignment="Center"/>
              </Grid>
            </Border>
          </Grid>
        </TabItem>
        <TabItem Header="设备地图">
          <ScrollViewer Margin="4">
            <Grid ColumnDefinitions="1.25*,1*" ColumnSpacing="12">
              <StackPanel Spacing="12">
                <Border Background="White" CornerRadius="10" Padding="17">
                  <StackPanel Spacing="10">
                    <TextBlock Text="生产线布局 / 虚拟设备分布" Foreground="#1D405F" FontSize="19" FontWeight="SemiBold"/>
                    <TextBlock Text="逐工件虚拟运动由 Master Core + 传感器状态提供；地图不代表实机定位或真实 PLC 驱动。"
                               FontSize="11" Foreground="#6D8197" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding ConveyorSummary}" FontSize="12" FontWeight="SemiBold"
                               Foreground="#1E729C" TextWrapping="Wrap"/>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                      <ItemsControl ItemsSource="{Binding LiveConveyor}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="8"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border MinWidth="134" Background="#E3F1F8" BorderBrush="#92B6CC"
                                    BorderThickness="1" CornerRadius="8" Padding="9">
                              <StackPanel Spacing="3">
                                <TextBlock Text="{Binding Workpiece}" FontSize="12" FontWeight="Bold"
                                           Foreground="#1D5275"/>
                                <TextBlock Text="{Binding Stage}" FontSize="15" FontWeight="SemiBold"
                                           Foreground="#1C739E"/>
                                <TextBlock Text="{Binding Progress}" FontSize="10" Foreground="#476B84"/>
                                <TextBlock Text="{Binding Sensor}" FontSize="10" Foreground="#667C8C"/>
                                <TextBlock Text="{Binding State}" FontSize="10" Foreground="#357C9B"/>
                              </StackPanel>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                      <Canvas Width="910" Height="425" Background="#E8F1F8">
                        <Border Canvas.Left="195" Canvas.Top="188" Width="65" Height="5" Background="#80A8C5"/>
                        <Border Canvas.Left="420" Canvas.Top="115" Width="55" Height="5" Background="#80A8C5"/>
                        <Border Canvas.Left="635" Canvas.Top="115" Width="55" Height="5" Background="#80A8C5"/>
                        <Border Canvas.Left="755" Canvas.Top="185" Width="5" Height="75" Background="#80A8C5"/>
                        <Border Canvas.Left="635" Canvas.Top="305" Width="55" Height="5" Background="#80A8C5"/>
                        <Border Canvas.Left="420" Canvas.Top="305" Width="55" Height="5" Background="#80A8C5"/>
                        <TextBlock Canvas.Left="210" Canvas.Top="168" Text="→" FontSize="22" Foreground="#4C8AAE"/>
                        <TextBlock Canvas.Left="441" Canvas.Top="91" Text="→" FontSize="22" Foreground="#4C8AAE"/>
                        <TextBlock Canvas.Left="656" Canvas.Top="91" Text="→" FontSize="22" Foreground="#4C8AAE"/>
                        <TextBlock Canvas.Left="781" Canvas.Top="215" Text="↓" FontSize="22" Foreground="#4C8AAE"/>
                        <TextBlock Canvas.Left="655" Canvas.Top="283" Text="←" FontSize="22" Foreground="#4C8AAE"/>
                        <TextBlock Canvas.Left="438" Canvas.Top="283" Text="←" FontSize="22" Foreground="#4C8AAE"/>
                        <Button Classes="station" Canvas.Left="36" Canvas.Top="145" Width="160" Height="94"
                                Classes.focused="{Binding MapStations[0].IsFocused}"
                                Command="{Binding FocusStationCommand}" CommandParameter="LOADING">
                          <StackPanel Spacing="4">
                            <TextBlock Text="LOADING / 定位" FontWeight="Bold" FontSize="14"/>
                            <TextBlock Text="{Binding MapStations[0].Channels}" FontSize="11"/>
                            <TextBlock Text="{Binding MapStations[0].Status}" FontSize="11" Foreground="#247795"/>
                          </StackPanel>
                        </Button>
                        <Button Classes="station" Canvas.Left="260" Canvas.Top="70" Width="160" Height="94"
                                Classes.focused="{Binding MapStations[1].IsFocused}"
                                Command="{Binding FocusStationCommand}" CommandParameter="ST03">
                          <StackPanel Spacing="4">
                            <TextBlock Text="ST03 / 双面" FontWeight="Bold" FontSize="14"/>
                            <TextBlock Text="{Binding MapStations[1].Channels}" FontSize="11"/>
                            <TextBlock Text="{Binding MapStations[1].Status}" FontSize="11" Foreground="#247795"/>
                          </StackPanel>
                        </Button>
                        <Button Classes="station" Canvas.Left="475" Canvas.Top="70" Width="160" Height="94"
                                Classes.focused="{Binding MapStations[2].IsFocused}"
                                Command="{Binding FocusStationCommand}" CommandParameter="ST04">
                          <StackPanel Spacing="4">
                            <TextBlock Text="ST04 / 双面" FontWeight="Bold" FontSize="14"/>
                            <TextBlock Text="{Binding MapStations[2].Channels}" FontSize="11"/>
                            <TextBlock Text="{Binding MapStations[2].Status}" FontSize="11" Foreground="#247795"/>
                          </StackPanel>
                        </Button>
                        <Button Classes="station" Canvas.Left="690" Canvas.Top="70" Width="160" Height="94"
                                Classes.focused="{Binding MapStations[3].IsFocused}"
                                Command="{Binding FocusStationCommand}" CommandParameter="ST05">
                          <StackPanel Spacing="4">
                            <TextBlock Text="ST05 / 检测" FontWeight="Bold" FontSize="14"/>
                            <TextBlock Text="{Binding MapStations[3].Channels}" FontSize="11"/>
                            <TextBlock Text="{Binding MapStations[3].Status}" FontSize="11" Foreground="#247795"/>
                          </StackPanel>
                        </Button>
                        <Button Classes="station" Canvas.Left="690" Canvas.Top="260" Width="160" Height="94"
                                Classes.focused="{Binding MapStations[4].IsFocused}"
                                Command="{Binding FocusStationCommand}" CommandParameter="ST06">
                          <StackPanel Spacing="4">
                            <TextBlock Text="ST06 / 检测" FontWeight="Bold" FontSize="14"/>
                            <TextBlock Text="{Binding MapStations[4].Channels}" FontSize="11"/>
                            <TextBlock Text="{Binding MapStations[4].Status}" FontSize="11" Foreground="#247795"/>
                          </StackPanel>
                        </Button>
                        <Button Classes="station" Canvas.Left="475" Canvas.Top="260" Width="160" Height="94"
                                Classes.focused="{Binding MapStations[5].IsFocused}"
                                Command="{Binding FocusStationCommand}" CommandParameter="ST09">
                          <StackPanel Spacing="4">
                            <TextBlock Text="ST09 / 线扫" FontWeight="Bold" FontSize="14"/>
                            <TextBlock Text="{Binding MapStations[5].Channels}" FontSize="11"/>
                            <TextBlock Text="{Binding MapStations[5].Status}" FontSize="11" Foreground="#247795"/>
                          </StackPanel>
                        </Button>
                        <Button Classes="station" Canvas.Left="260" Canvas.Top="260" Width="160" Height="94"
                                Classes.focused="{Binding MapStations[6].IsFocused}"
                                Command="{Binding FocusStationCommand}" CommandParameter="ST10">
                          <StackPanel Spacing="4">
                            <TextBlock Text="ST10 / 线扫" FontWeight="Bold" FontSize="14"/>
                            <TextBlock Text="{Binding MapStations[6].Channels}" FontSize="11"/>
                            <TextBlock Text="{Binding MapStations[6].Status}" FontSize="11" Foreground="#247795"/>
                          </StackPanel>
                        </Button>
                        <TextBlock Canvas.Left="35" Canvas.Top="385" Text="● 蓝色连线：逻辑工位顺序     ● 设备图和 PLC 表共享 ChannelCatalog 绑定"
                                   FontSize="11" Foreground="#587994"/>
                      </Canvas>
                    </ScrollViewer>
                    <TextBlock Text="{Binding MapSelectionSummary}" Foreground="#21698D" FontWeight="SemiBold" FontSize="13"
                               TextWrapping="Wrap"/>
                  </StackPanel>
                </Border>
                <Border Background="White" CornerRadius="10" Padding="14">
                  <Grid RowDefinitions="Auto,*" RowSpacing="8">
                    <TextBlock Text="工位通道列表 · 双向选择" FontSize="16" FontWeight="SemiBold" Foreground="#204662"/>
                    <ListBox Grid.Row="1" ItemsSource="{Binding Channels}" SelectedItem="{Binding SelectedChannel, Mode=TwoWay}"
                             Height="240" BorderThickness="0" Background="#F6F9FC">
                      <ListBox.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate>
                      </ListBox.ItemsPanel>
                      <ListBox.ItemTemplate>
                        <DataTemplate>
                          <Grid ColumnDefinitions="63,*,92" Margin="6,9">
                            <TextBlock Text="{Binding ChannelId}" FontWeight="SemiBold" FontSize="12"/>
                            <TextBlock Grid.Column="1" Text="{Binding StationDetails}" FontSize="10" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="2" Text="{Binding State}" FontSize="10" Foreground="#287595"/>
                          </Grid>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </Grid>
                </Border>
              </StackPanel>
              <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="18">
                <StackPanel Spacing="11">
                  <TextBlock Text="通道详情 / 图像 / ROI" Foreground="#1D405F" FontSize="19" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding SelectedDescription}" FontSize="12" Foreground="#506982" TextWrapping="Wrap"/>
                  <Border Background="#132D43" CornerRadius="9" Padding="10">
                    <Image Source="{Binding SelectedPreview}" Height="250" Stretch="Uniform"/>
                  </Border>
                  <TextBlock Text="{Binding PreviewNotice}" FontSize="11" Foreground="#57748B" TextWrapping="Wrap"/>
                  <TextBlock Text="{Binding ViewedWorkpieceLabel}" FontSize="11" Foreground="#207496" TextWrapping="Wrap"/>
                  <TextBlock Text="归一化 ROI 草稿 (X / Y / 宽 / 高)" FontSize="13" FontWeight="SemiBold" Foreground="#234B67"/>
                  <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                    <StackPanel><TextBlock Text="X" FontSize="11"/><TextBox Text="{Binding RoiX}"/></StackPanel>
                    <StackPanel Grid.Column="1"><TextBlock Text="Y" FontSize="11"/><TextBox Text="{Binding RoiY}"/></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="宽" FontSize="11"/><TextBox Text="{Binding RoiWidth}"/></StackPanel>
                    <StackPanel Grid.Column="3"><TextBlock Text="高" FontSize="11"/><TextBox Text="{Binding RoiHeight}"/></StackPanel>
                  </Grid>
                  <Button Content="保存 Core ROI 草稿（不自动发布）" Command="{Binding ValidateRoiCommand}"/>
                  <TextBlock Text="{Binding RoiFeedback}" Foreground="#8B622F" FontSize="11" TextWrapping="Wrap"/>
                  <Button Content="浏览当前工件 11 路图集" Command="{Binding NavigateWorkspaceCommand}" CommandParameter="2"/>
                </StackPanel>
              </Border>
            </Grid>
          </ScrollViewer>
        </TabItem>
        <TabItem Header="11路图集">
          <Grid Margin="4" RowDefinitions="Auto,Auto,*" RowSpacing="11">
            <Border Background="White" CornerRadius="10" Padding="15">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="5">
                  <TextBlock Text="11 路工件原始图像 / Master + Slave" FontSize="19" FontWeight="SemiBold" Foreground="#204362"/>
                  <TextBlock Text="{Binding GallerySummary}" FontSize="12" Foreground="#5F7892" TextWrapping="Wrap"/>
                  <TextBlock Text="{Binding ViewedWorkpieceLabel}" FontSize="11" Foreground="#217595" TextWrapping="Wrap"/>
                </StackPanel>
                <Button Grid.Column="1" Content="返回实时工件" Command="{Binding FollowLiveCommand}"
                        VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled" MaxHeight="120">
              <ListBox ItemsSource="{Binding RecentWorkpieces}"
                       SelectedItem="{Binding SelectedHistoryItem, Mode=TwoWay}"
                       Background="Transparent" BorderThickness="0">
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="8"/></ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Background="White" Spacing="5" MinWidth="175">
                      <TextBlock Text="{Binding ShortId}" FontWeight="Bold" FontSize="13" Foreground="#235A7B"/>
                      <TextBlock Text="{Binding Barcode}" FontSize="11" Foreground="#526D84"/>
                      <TextBlock Text="{Binding Decision}" FontSize="11" Foreground="#987039"/>
                      <TextBlock Text="{Binding Channels}" FontSize="10" Foreground="#7991A5"/>
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </ScrollViewer>
            <Border Grid.Row="2" Background="#E7EFF6" CornerRadius="10" Padding="10">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding GalleryChannels}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Margin="6" Padding="8" Background="White" BorderBrush="#CEDDE9"
                              BorderThickness="1" Command="{Binding OpenCommand}" MinHeight="222">
                        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="7">
                          <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding ChannelId}" FontSize="18" FontWeight="Bold" Foreground="#244C6D"/>
                            <TextBlock Grid.Column="1" Text="{Binding Owner}" FontSize="10" Foreground="#7B94AA"/>
                          </Grid>
                          <Border Grid.Row="1" Background="#122D44" CornerRadius="6" Padding="5">
                            <Image Source="{Binding Preview}" Stretch="Uniform" Height="140"/>
                          </Border>
                          <StackPanel Grid.Row="2" Spacing="3">
                            <TextBlock Text="{Binding Location}" FontSize="11" Foreground="#59728A"/>
                            <TextBlock Text="{Binding ImageStatus}" FontSize="10" Foreground="#2A7796"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding ChannelState}" FontSize="10" Foreground="#8A97A8"/>
                            <TextBlock Text="点击定位设备与 ROI →" FontSize="10" Foreground="#244E75"/>
                          </StackPanel>
                        </Grid>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Border>
          </Grid>
        </TabItem>
        <TabItem Header="历史HOLD">
          <Grid Margin="4" ColumnDefinitions="1.05*,1*" ColumnSpacing="12">
            <Border Background="White" CornerRadius="10" Padding="16">
              <Grid RowDefinitions="Auto,Auto,*" RowSpacing="9">
                <TextBlock Text="真实 WAL 工件历史 · 点击查看 11 路原图" FontSize="18" FontWeight="SemiBold" Foreground="#214665"/>
                <TextBlock Grid.Row="1" Text="{Binding ProductionCounters}" FontSize="12" Foreground="#247797"/>
                <ListBox Grid.Row="2" ItemsSource="{Binding RecentWorkpieces}"
                         SelectedItem="{Binding SelectedHistoryItem, Mode=TwoWay}"
                         Background="#F5F8FB" BorderThickness="0">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Grid ColumnDefinitions="115,*,80,100,120" Margin="10,12">
                        <TextBlock Text="{Binding ShortId}" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" Text="{Binding Barcode}" FontSize="11" Foreground="#56728A"/>
                        <TextBlock Grid.Column="2" Text="{Binding Channels}" FontSize="11"/>
                        <TextBlock Grid.Column="3" Text="{Binding Decision}" FontSize="11" Foreground="#A16B34"/>
                        <TextBlock Grid.Column="4" Text="{Binding LocalTime}" FontSize="11" Foreground="#7C91A5"/>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Grid>
            </Border>
            <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="16">
              <Grid RowDefinitions="Auto,Auto,*" RowSpacing="9">
                <TextBlock Text="持久化异常 / HOLD 记录" FontSize="18" FontWeight="SemiBold" Foreground="#903E30"/>
                <TextBlock Grid.Row="1" Text="{Binding HoldNotice}" FontSize="12" Foreground="#A3553D" TextWrapping="Wrap"/>
                <ListBox Grid.Row="2" ItemsSource="{Binding HeldWorkpieces}"
                         Background="#FFF8F4" BorderThickness="0">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Spacing="7" Margin="9" Background="White">
                        <Grid ColumnDefinitions="*,110">
                          <TextBlock Text="{Binding ReasonCode}" FontSize="13" FontWeight="Bold" Foreground="#A23D34"/>
                          <TextBlock Grid.Column="1" Text="{Binding ShortId}" FontSize="11" Foreground="#607790"/>
                        </Grid>
                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="12" Foreground="#526B81"/>
                        <TextBlock Text="{Binding RaisedUtc}" FontSize="11" Foreground="#788FA1"/>
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Grid>
            </Border>
          </Grid>
        </TabItem>
        <TabItem Header="PLC">
          <TabControl Margin="4">
            <TabItem Header="逐件采集诊断">
              <Grid RowDefinitions="Auto,1.3*,1*" RowSpacing="9" Margin="6">
                <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="13">
                  <Grid ColumnDefinitions="*,180" ColumnSpacing="14">
                    <StackPanel Spacing="5">
                      <TextBlock Text="真实 Core IPC · 逐件采集 / 检测调试" FontSize="17" FontWeight="SemiBold"/>
                      <TextBlock Text="{Binding CaptureDebugIdentity}" FontSize="12" Foreground="#275B80" TextWrapping="Wrap"/>
                      <TextBlock Text="{Binding CaptureDebugLastSnapshot}" FontSize="11" TextWrapping="Wrap"/>
                      <TextBlock Text="{Binding CaptureDebugError}" FontSize="11" Foreground="#A14837" TextWrapping="Wrap"/>
                      <TextBlock Text="{Binding CaptureDebugNotice}" FontSize="11" Foreground="#94713B" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="7">
                      <Button Content="核验本件11路PNG" Command="{Binding VerifyCapturePngCommand}"/>
                      <Button Content="读取真实时序" AutomationProperties.Name="读取真实时序"
                              Command="{Binding ReadCaptureTimingCommand}" />
                      <Button Content="回到最新工件" Command="{Binding FollowLiveCommand}"/>
                      <TextBlock Text="直接选择历史工件" FontSize="11"/>
                      <ComboBox ItemsSource="{Binding RecentWorkpieces}"
                                SelectedItem="{Binding CaptureDebugPickedWorkpiece, Mode=TwoWay}"
                                HorizontalAlignment="Stretch" MinWidth="165">
                        <ComboBox.ItemTemplate>
                          <DataTemplate>
                            <StackPanel>
                              <TextBlock Text="{Binding ShortId}" FontWeight="SemiBold"/>
                              <TextBlock Text="{Binding Barcode}" FontSize="10"/>
                            </StackPanel>
                          </DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
                    </StackPanel>
                  </Grid>
                </Border>
                <Grid Grid.Row="1" ColumnDefinitions="1.3*,1*" ColumnSpacing="9">
                  <Border Background="White" CornerRadius="8" Padding="10">
                    <Grid RowDefinitions="Auto,*" RowSpacing="6">
                      <TextBlock Text="11通道 · PLC地址 / 结果 / UTC / PNG；点击选择相机"
                                 FontSize="13" FontWeight="SemiBold"/>
                      <ListBox Grid.Row="1" ItemsSource="{Binding CaptureDebugChannels}"
                               SelectedItem="{Binding SelectedCaptureDebugRow, Mode=TwoWay}"
                               Background="#F4F8FC" BorderThickness="0">
                        <ListBox.ItemTemplate>
                          <DataTemplate>
                            <Grid ColumnDefinitions="60,62,74,*,112" Margin="5,8">
                              <TextBlock Text="{Binding ChannelId}" FontSize="11" FontWeight="SemiBold"/>
                              <TextBlock Grid.Column="1" Text="{Binding StationId}" FontSize="10"/>
                              <TextBlock Grid.Column="2" Text="{Binding PlcAddress}" FontSize="10"/>
                              <StackPanel Grid.Column="3" Spacing="2">
                                <TextBlock Text="{Binding InspectionResult}" FontSize="11" Foreground="#247396"/>
                                <TextBlock Text="{Binding PngEvidence}" FontSize="10" Foreground="#587D95" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Error}" FontSize="10" Foreground="#A64B32" TextWrapping="Wrap"/>
                              </StackPanel>
                              <TextBlock Grid.Column="4" Text="{Binding ResultUtc}" FontSize="10"
                                         TextWrapping="Wrap" Foreground="#647E94"/>
                            </Grid>
                          </DataTemplate>
                        </ListBox.ItemTemplate>
                      </ListBox>
                    </Grid>
                  </Border>
                  <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="12">
                    <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="7">
                      <TextBlock Text="采集请求 / FrameReady / CamDone / 图像"
                                 FontSize="13" FontWeight="SemiBold"/>
                      <StackPanel Grid.Row="1" Spacing="5">
                        <TextBlock Text="{Binding SelectedCaptureDebugRow.PhysicalDeviceId}"
                                   FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding SelectedCaptureDebugRow.RequestEvidence}"
                                   FontSize="11" Foreground="#9D623E" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding SelectedCaptureDebugRow.SensorEvidence}"
                                   FontSize="11" Foreground="#44708D" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding SelectedCaptureDebugRow.FrameReadyEvidence}"
                                   FontSize="11" Foreground="#9D623E" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding SelectedCaptureDebugRow.CamDoneEvidence}"
                                   FontSize="11" Foreground="#9D623E" TextWrapping="Wrap"/>
                      </StackPanel>
                      <Border Grid.Row="2" Background="#112E48" Padding="8" CornerRadius="6">
                        <Image Source="{Binding SelectedPreview}" Stretch="Uniform"/>
                      </Border>
                      <TextBlock Grid.Row="3" Text="{Binding PreviewNotice}" FontSize="10"
                                 Foreground="#5E7890" TextWrapping="Wrap"/>
                    </Grid>
                  </Border>
                </Grid>
                <Grid Grid.Row="2" RowDefinitions="Auto,Auto,*" RowSpacing="6">
                  <TextBlock Text="A7 持久化真实时序（A0 Master IPC 127.0.0.1:19652）"
                             FontSize="13" FontWeight="SemiBold"/>
                  <TextBlock Grid.Row="1" Text="{Binding CaptureTimingSummary}"
                             FontSize="11" Foreground="#916C40" TextWrapping="Wrap"/>
                  <TabControl Grid.Row="2">
                    <TabItem Header="真实 PLC / 相机 / 检测时间线">
                      <Grid ColumnDefinitions="*,245" ColumnSpacing="8">
                        <ListBox ItemsSource="{Binding ActualCaptureTimingEvents}"
                                 SelectedItem="{Binding SelectedCaptureTimingEvent, Mode=TwoWay}"
                                 Background="#F4F8FC" BorderThickness="0">
                          <ListBox.ItemTemplate>
                            <DataTemplate>
                              <Grid ColumnDefinitions="103,63,131,110,*,138" Margin="5,6" ColumnSpacing="3">
                                <TextBlock Text="{Binding EventUtc}" FontSize="10" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="1" Text="{Binding NodeId}" FontSize="10"/>
                                <StackPanel Grid.Column="2" Spacing="2">
                                  <TextBlock Text="{Binding Stage}" FontSize="10" FontWeight="SemiBold"
                                             TextWrapping="Wrap"/>
                                  <TextBlock Text="{Binding Provenance}" FontSize="9"
                                             Foreground="#8A693F" TextWrapping="Wrap"/>
                                </StackPanel>
                                <TextBlock Grid.Column="3" Text="{Binding ChannelDevice}"
                                           FontSize="10" TextWrapping="Wrap"/>
                                <StackPanel Grid.Column="4" Spacing="2">
                                  <TextBlock Text="{Binding PlcEvidence}" FontSize="10"
                                             TextWrapping="Wrap" Foreground="#296A8C"/>
                                  <TextBlock Text="{Binding CaptureIdentity}" FontSize="10" TextWrapping="Wrap"/>
                                </StackPanel>
                                <TextBlock Grid.Column="5" Text="{Binding Status}" FontSize="10"
                                           TextWrapping="Wrap" Foreground="#57728C"/>
                              </Grid>
                            </DataTemplate>
                          </ListBox.ItemTemplate>
                        </ListBox>
                        <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*" RowSpacing="6">
                          <TextBlock Text="A7 时序故障 / 归属异常" FontWeight="SemiBold" FontSize="12"/>
                          <TextBlock Grid.Row="1" Text="{Binding CaptureTimingFindingsMessage}"
                                     FontSize="10" Foreground="#976B42" TextWrapping="Wrap"/>
                          <ListBox Grid.Row="2" ItemsSource="{Binding ActualCaptureTimingFindings}"
                                   BorderThickness="0" Background="#F8F5F1">
                            <ListBox.ItemTemplate>
                              <DataTemplate>
                                <StackPanel Spacing="3" Margin="5,7">
                                  <TextBlock Text="{Binding Severity}" Foreground="#B14E35"
                                             FontSize="10" FontWeight="Bold"/>
                                  <TextBlock Text="{Binding Code}" FontSize="10" TextWrapping="Wrap"/>
                                  <TextBlock Text="{Binding Detail}" FontSize="10" TextWrapping="Wrap"/>
                                </StackPanel>
                              </DataTemplate>
                            </ListBox.ItemTemplate>
                          </ListBox>
                        </Grid>
                      </Grid>
                    </TabItem>
                    <TabItem Header="旧快照观察（非报文证据）">
                <Border Background="White" CornerRadius="8" Padding="12">
                  <Grid RowDefinitions="Auto,*" RowSpacing="6">
                    <TextBlock Text="快照变化日志（只证明Core已报告的状态，不代替原始FINS写入顺序）"
                               FontSize="13" FontWeight="SemiBold"/>
                    <ListBox Grid.Row="1" ItemsSource="{Binding CaptureDebugTimeline}"
                             Background="#F4F8FC" BorderThickness="0">
                      <ListBox.ItemTemplate>
                        <DataTemplate>
                          <Grid ColumnDefinitions="100,100,75,100,155,*,155" Margin="6,7">
                            <TextBlock Text="{Binding ObservedTime}" FontSize="10"/>
                            <TextBlock Grid.Column="1" Text="{Binding SourceTime}" FontSize="10" TextWrapping="Wrap"/>
                            <TextBlock Grid.Column="2" Text="{Binding ShortWorkpiece}" FontSize="10"/>
                            <TextBlock Grid.Column="3" Text="{Binding PlcAddress}" FontSize="10"/>
                            <TextBlock Grid.Column="4" Text="{Binding Kind}" FontSize="10" TextWrapping="Wrap"/>
                            <TextBlock Grid.Column="5" Text="{Binding Detail}" FontSize="10"
                                       TextWrapping="Wrap" Foreground="#39718C"/>
                            <TextBlock Grid.Column="6" Text="{Binding Source}" FontSize="10" TextWrapping="Wrap"/>
                          </Grid>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </Grid>
                </Border>
                    </TabItem>
                  </TabControl>
                </Grid>
              </Grid>
            </TabItem>
            <TabItem Header="45条PLC工程台账">
          <Grid Margin="4" ColumnDefinitions="1.45*,1*" ColumnSpacing="12">
            <Border Background="White" CornerRadius="10" Padding="15">
              <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="9">
                <TextBlock Text="45 条 PLC 工程信号 · 点击定位设备地图" FontSize="18" FontWeight="SemiBold" Foreground="#1F4665"/>
                <TextBlock Grid.Row="1" Text="{Binding EngineeringRegistryState}" FontSize="12" Foreground="#8C683E" TextWrapping="Wrap"/>
                <Grid Grid.Row="2" ColumnDefinitions="160,90,75,85,95,*" Margin="10,4">
                  <TextBlock Text="信号" FontWeight="SemiBold" FontSize="11"/>
                  <TextBlock Grid.Column="1" Text="DM 地址" FontWeight="SemiBold" FontSize="11"/>
                  <TextBlock Grid.Column="2" Text="工位" FontWeight="SemiBold" FontSize="11"/>
                  <TextBlock Grid.Column="3" Text="主从" FontWeight="SemiBold" FontSize="11"/>
                  <TextBlock Grid.Column="4" Text="方向" FontWeight="SemiBold" FontSize="11"/>
                  <TextBlock Grid.Column="5" Text="说明" FontWeight="SemiBold" FontSize="11"/>
                </Grid>
                <ListBox Grid.Row="3" ItemsSource="{Binding PlcSignals}"
                         SelectedItem="{Binding SelectedPlcSignal, Mode=TwoWay}"
                         Background="#F4F8FC" BorderThickness="0">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Grid ColumnDefinitions="160,90,75,85,95,*" Margin="9,10">
                        <TextBlock Text="{Binding Id}" FontSize="11" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" Foreground="#275270"/>
                        <TextBlock Grid.Column="1" Text="{Binding DmAddress}" FontSize="11"/>
                        <TextBlock Grid.Column="2" Text="{Binding Station}" FontSize="11"/>
                        <TextBlock Grid.Column="3" Text="{Binding Host}" FontSize="10" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="4" Text="{Binding Direction}" FontSize="10" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="5" Text="{Binding Purpose}" FontSize="11"
                                   TextWrapping="Wrap" Foreground="#5C7085"/>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Grid>
            </Border>
            <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="16">
              <Grid RowDefinitions="Auto,Auto,*" RowSpacing="9">
                <TextBlock Text="工程详情 / 14 项现场验证记录" FontSize="17" FontWeight="SemiBold" Foreground="#1F4665"/>
                <StackPanel Grid.Row="1" Spacing="5" Background="#EDF5FB">
                  <TextBlock Text="{Binding SelectedDescription}" FontSize="12" TextWrapping="Wrap" Foreground="#426A88"/>
                  <TextBlock Text="工程地址仅作查阅；尚非 PLC 实时读值，不能从界面发送生产写入。" FontSize="11"
                             Foreground="#986438" TextWrapping="Wrap"/>
                </StackPanel>
                <ListBox Grid.Row="2" ItemsSource="{Binding PlcGates}"
                         SelectedItem="{Binding SelectedFieldGate, Mode=TwoWay}"
                         BorderThickness="0" Background="#F6F8FB">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Background="White" Margin="4" Spacing="5">
                        <Grid ColumnDefinitions="72,*,85">
                          <TextBlock Text="{Binding GateId}" FontSize="12" FontWeight="Bold"/>
                          <TextBlock Grid.Column="1" Text="{Binding Topic}" FontSize="12" TextWrapping="Wrap"/>
                          <TextBlock Grid.Column="2" Text="{Binding Status}" FontSize="11" Foreground="#A24835"/>
                        </Grid>
                        <TextBlock Text="{Binding RequiredEvidence}" TextWrapping="Wrap" Foreground="#71859A" FontSize="11"/>
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Grid>
            </Border>
          </Grid>
            </TabItem>
          </TabControl>
        </TabItem>
        <TabItem Header="产品ROI">
          <Grid Margin="4" RowDefinitions="Auto,*" RowSpacing="10">
            <Border Background="#FFF7EA" CornerRadius="10" Padding="15"
                    IsVisible="{Binding OfflineProduct.IsOfflineEditorTab}">
              <StackPanel Spacing="8">
                <TextBlock Text="OFFLINE_RECIPE_MANAGEMENT · 离线产品 / ROI 编辑（A6 真实数据库）"
                           FontSize="17" FontWeight="SemiBold" Foreground="#7A4A12"/>
                <TextBlock Text="显式入口：A6 solutions.sqlite 或 run-root + 操作员。写入受双 Core 独占锁保护：未开启写入会话时 A6 只读；开启后仅可写租期内且属于该 run-root 的数据库。"
                           Foreground="#8A6528" FontSize="11" TextWrapping="Wrap"/>
                <Grid ColumnDefinitions="2.2*,1.1*" ColumnSpacing="9">
                  <StackPanel>
                    <TextBlock Text="A6 路径（solutions.sqlite 或 run-root）" FontSize="11"/>
                    <TextBox Text="{Binding OfflineProduct.EntryPath}"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="操作员" FontSize="11"/>
                    <TextBox Text="{Binding OfflineProduct.OperatorId}"/>
                  </StackPanel>
                </Grid>
                <!-- Wrap so all four actions stay visible and clickable at 1250x760 and 1920x1080. -->
                <WrapPanel Orientation="Horizontal">
                  <Button Content="启用离线方案管理" Margin="0,0,9,8"
                          Command="{Binding OfflineProduct.AttachEntryCommand}"/>
                  <Button Content="重新读取数据库" Margin="0,0,9,8"
                          Command="{Binding OfflineProduct.RefreshCommand}"/>
                  <Button Content="开启离线写入会话（双 Core 独占锁）" Margin="0,0,9,8"
                          Command="{Binding OfflineProduct.EnableOfflineWritesCommand}"/>
                  <Button Content="关闭写入会话（释放双锁）" Margin="0,0,9,8"
                          Command="{Binding OfflineProduct.DisableOfflineWritesCommand}"/>
                </WrapPanel>
                <TextBlock Text="{Binding OfflineProduct.WriteState}" FontSize="12"
                           Foreground="#A23D2A" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding OfflineProduct.DatabasePathLabel}" FontSize="11"
                           Foreground="#6E8297" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
            <!-- Default is the existing Core ROI editor so ordinary master/slave
                 startup keeps the native operator-smoke save button visible. The
                 offline editor is selected only by explicit launch or operator choice. -->
            <TabControl Grid.Row="1" SelectedIndex="{Binding OfflineProduct.ProductRoiTabIndex, Mode=TwoWay}">
              <TabItem Header="Core ROI 草稿（现有）">
                <Grid ColumnDefinitions="1*,1*" ColumnSpacing="12">
                  <Border Background="White" CornerRadius="10" Padding="18">
                    <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="10">
                      <TextBlock Text="当前已发布产品方案" FontSize="19" FontWeight="SemiBold" Foreground="#1E4263"/>
                      <TextBlock Grid.Row="1" Text="{Binding ActiveProductLabel}" FontSize="14" Foreground="#277295" TextWrapping="Wrap"/>
                      <TextBlock Grid.Row="2" Text="{Binding ActiveProductRelease}" FontSize="12" Foreground="#6B8195" TextWrapping="Wrap"/>
                      <ListBox Grid.Row="3" ItemsSource="{Binding ProductStations}" Background="#F5F8FB" BorderThickness="0">
                        <ListBox.ItemTemplate>
                          <DataTemplate>
                            <Grid ColumnDefinitions="90,*,95,110" Margin="10,12">
                              <TextBlock Text="{Binding StationId}" FontWeight="Bold" FontSize="12"/>
                              <TextBlock Grid.Column="1" Text="{Binding Channels}" FontSize="11"/>
                              <TextBlock Grid.Column="2" Text="{Binding BrightThreshold}" FontSize="12"/>
                              <TextBlock Grid.Column="3" Text="{Binding MinimumBrightFraction}" FontSize="12"/>
                            </Grid>
                          </DataTemplate>
                        </ListBox.ItemTemplate>
                      </ListBox>
                    </Grid>
                  </Border>
                  <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="14">
                    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto,Auto,Auto" RowSpacing="6">
                      <TextBlock Text="本机 ROI 草稿 / Core 保存" FontSize="17"
                                 FontWeight="SemiBold" Foreground="#1E4263"/>
                      <TextBlock Grid.Row="1" Text="{Binding SelectedDescription}" FontSize="11"
                                 Foreground="#587187" TextWrapping="Wrap" MaxLines="2"
                                 TextTrimming="CharacterEllipsis"/>
                      <ListBox Grid.Row="2" ItemsSource="{Binding Channels}"
                               SelectedItem="{Binding SelectedChannel, Mode=TwoWay}"
                               Height="72" BorderThickness="0" Background="#F4F8FC">
                        <ListBox.ItemsPanel>
                          <ItemsPanelTemplate><UniformGrid Columns="6"/></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                          <DataTemplate>
                            <TextBlock Text="{Binding ChannelId}" Margin="10,6" FontWeight="SemiBold"/>
                          </DataTemplate>
                        </ListBox.ItemTemplate>
                      </ListBox>
                      <Border Grid.Row="3" Background="#122D44" Padding="6" CornerRadius="8">
                        <Image Source="{Binding SelectedPreview}" Stretch="Uniform"/>
                      </Border>
                      <TextBlock Grid.Row="4" Text="{Binding PreviewNotice}" FontSize="10"
                                 Foreground="#65819A" TextWrapping="Wrap" MaxLines="2"
                                 TextTrimming="CharacterEllipsis"/>
                      <Grid Grid.Row="5" ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                        <StackPanel><TextBlock Text="X" FontSize="10"/><TextBox Text="{Binding RoiX}"/></StackPanel>
                        <StackPanel Grid.Column="1"><TextBlock Text="Y" FontSize="10"/><TextBox Text="{Binding RoiY}"/></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="宽" FontSize="10"/><TextBox Text="{Binding RoiWidth}"/></StackPanel>
                        <StackPanel Grid.Column="3"><TextBlock Text="高" FontSize="10"/><TextBox Text="{Binding RoiHeight}"/></StackPanel>
                      </Grid>
                      <Button Grid.Row="6" Content="校验并持久保存 SIM_ONLY ROI 草稿"
                              Command="{Binding ValidateRoiCommand}"/>
                      <TextBlock Grid.Row="7" Text="{Binding RoiFeedback}" FontSize="11"
                                 Foreground="#96652C" TextWrapping="Wrap" MaxLines="2"
                                 TextTrimming="CharacterEllipsis"/>
                      <TextBlock Grid.Row="8" Text="已保存的草稿不自动发布；当前检测参数以已发布方案为准。"
                                 FontSize="10" TextWrapping="Wrap" MaxLines="2"
                                 TextTrimming="CharacterEllipsis" Foreground="#637C92"/>
                    </Grid>
                  </Border>
                </Grid>
              </TabItem>
              <TabItem Header="离线产品编辑">
                <Grid ColumnDefinitions="1.08*,1*" ColumnSpacing="12">
                  <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="10">
                      <Border Background="White" CornerRadius="10" Padding="14">
                        <StackPanel Spacing="8">
                          <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="A6 产品方案（真实列表）" FontSize="16"
                                       FontWeight="SemiBold" Foreground="#1E4263"/>
                            <TextBlock Grid.Column="1" Text="{Binding OfflineProduct.ReleaseSummary}"
                                       FontSize="11" Foreground="#6E8297"/>
                          </Grid>
                          <ComboBox ItemsSource="{Binding OfflineProduct.Solutions}"
                                    SelectedItem="{Binding OfflineProduct.SelectedSolution, Mode=TwoWay}"
                                    HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                              <DataTemplate><TextBlock Text="{Binding Display}"/></DataTemplate>
                            </ComboBox.ItemTemplate>
                          </ComboBox>
                          <Grid ColumnDefinitions="1*,1.4*,Auto" ColumnSpacing="7">
                            <StackPanel>
                              <TextBlock Text="新产品 ID" FontSize="11"/>
                              <TextBox Text="{Binding OfflineProduct.NewSolutionId}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                              <TextBlock Text="显示名称" FontSize="11"/>
                              <TextBox Text="{Binding OfflineProduct.NewSolutionName}"/>
                            </StackPanel>
                            <Button Grid.Column="2" Content="创建 SIM 产品草稿"
                                    Command="{Binding OfflineProduct.CreateProductCommand}"
                                    VerticalAlignment="Bottom"/>
                          </Grid>
                          <TextBlock Text="{Binding OfflineProduct.ChannelSummary}" FontSize="11"
                                     Foreground="#39718C"/>
                          <TextBlock Text="{Binding OfflineProduct.Status}" FontSize="11"
                                     Foreground="#8A6528" TextWrapping="Wrap"/>
                        </StackPanel>
                      </Border>
                      <Border Background="White" CornerRadius="10" Padding="14">
                        <StackPanel Spacing="8">
                          <TextBlock Text="通道草稿（CAS revision）" FontSize="16"
                                     FontWeight="SemiBold" Foreground="#1E4263"/>
                          <Grid ColumnDefinitions="2*,Auto,Auto" ColumnSpacing="7">
                            <ComboBox ItemsSource="{Binding OfflineProduct.Channels}"
                                      SelectedItem="{Binding OfflineProduct.SelectedChannel, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch">
                              <ComboBox.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding Display}"/></DataTemplate>
                              </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Grid.Column="1" Content="读取通道草稿"
                                    Command="{Binding OfflineProduct.LoadChannelCommand}"/>
                            <Button Grid.Column="2" Content="校验（不写入）"
                                    Command="{Binding OfflineProduct.ValidateCommand}"/>
                          </Grid>
                          <Grid ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="14">
                            <TextBlock Text="工位：" FontSize="11"/>
                            <TextBlock Grid.Column="1" Text="{Binding OfflineProduct.StationId}"
                                       FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="2" Text="草稿 revision：" FontSize="11"/>
                            <TextBlock Grid.Column="3" Text="{Binding OfflineProduct.StationRevision}"
                                       FontSize="12" FontWeight="SemiBold"/>
                          </Grid>
                          <TextBlock Text="{Binding OfflineProduct.RoiModeText}" FontSize="11"
                                     Foreground="#6E8297"/>
                          <TextBlock Text="{Binding OfflineProduct.ValidationMessage}" FontSize="11"
                                     Foreground="#A23D2A" TextWrapping="Wrap"/>
                        </StackPanel>
                      </Border>
                      <Border Background="White" CornerRadius="10" Padding="14">
                        <StackPanel Spacing="8">
                          <TextBlock Text="参数 / 已安装 SIM 插件" FontSize="16"
                                     FontWeight="SemiBold" Foreground="#1E4263"/>
                          <ComboBox ItemsSource="{Binding OfflineProduct.AlgorithmChoices}"
                                    SelectedItem="{Binding OfflineProduct.SelectedAlgorithm, Mode=TwoWay}"
                                    HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                              <DataTemplate><TextBlock Text="{Binding DisplayLabel}"/></DataTemplate>
                            </ComboBox.ItemTemplate>
                          </ComboBox>
                          <Grid ColumnDefinitions="*,*" ColumnSpacing="9">
                            <StackPanel>
                              <TextBlock Text="站亮度阈值 (1..254 整数)" FontSize="11"/>
                              <TextBox Text="{Binding OfflineProduct.BrightThreshold, Mode=TwoWay}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                              <TextBlock Text="最小亮区比例 (0..1)" FontSize="11"/>
                              <TextBox Text="{Binding OfflineProduct.MinimumBrightFraction, Mode=TwoWay}"/>
                            </StackPanel>
                          </Grid>
                          <StackPanel IsVisible="{Binding OfflineProduct.IsContourAlgorithm}" Spacing="7">
                            <TextBlock Text="opencv.contour 数值参数" FontSize="12"
                                       FontWeight="SemiBold" Foreground="#39718C"/>
                            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="7">
                              <StackPanel>
                                <TextBlock Text="二值阈值" FontSize="11"/>
                                <TextBox Text="{Binding OfflineProduct.BinaryThresholdText}"/>
                              </StackPanel>
                              <StackPanel Grid.Column="1">
                                <TextBlock Text="最小轮廓面积" FontSize="11"/>
                                <TextBox Text="{Binding OfflineProduct.MinimumContourAreaText}"/>
                              </StackPanel>
                              <StackPanel Grid.Column="2">
                                <TextBlock Text="最大缺陷数" FontSize="11"/>
                                <TextBox Text="{Binding OfflineProduct.MaximumDetectionsText}"/>
                              </StackPanel>
                              <StackPanel Grid.Column="3">
                                <TextBlock Text="找亮缺陷" FontSize="11"/>
                                <CheckBox IsChecked="{Binding OfflineProduct.FindBrightDefects, Mode=TwoWay}"/>
                              </StackPanel>
                            </Grid>
                          </StackPanel>
                        </StackPanel>
                      </Border>
                      <Border Background="White" CornerRadius="10" Padding="14">
                        <StackPanel Spacing="8">
                          <TextBlock Text="ROI（归一化，关联实际图像尺寸）" FontSize="16"
                                     FontWeight="SemiBold" Foreground="#1E4263"/>
                          <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                            <StackPanel>
                              <TextBlock Text="X" FontSize="11"/>
                              <TextBox Text="{Binding OfflineProduct.RoiX}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                              <TextBlock Text="Y" FontSize="11"/>
                              <TextBox Text="{Binding OfflineProduct.RoiY}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                              <TextBlock Text="宽" FontSize="11"/>
                              <TextBox Text="{Binding OfflineProduct.RoiWidth}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3">
                              <TextBlock Text="高" FontSize="11"/>
                              <TextBox Text="{Binding OfflineProduct.RoiHeight}"/>
                            </StackPanel>
                          </Grid>
                          <TextBlock Text="{Binding OfflineProduct.RoiImageState}" FontSize="11"
                                     Foreground="#39718C" TextWrapping="Wrap"/>
                          <TextBlock Text="{Binding OfflineProduct.RoiPixelPreviewText}" FontSize="11"
                                     Foreground="#8A6528" TextWrapping="Wrap"/>
                          <Button Content="校验并 CAS 保存草稿（不发布）"
                                  Command="{Binding OfflineProduct.SaveDraftCommand}"
                                  HorizontalAlignment="Stretch"/>
                          <TextBlock Text="草稿保存不会改变已发布 Release / Active / Epoch；ROI 仅存在于产品草稿。"
                                     FontSize="11" Foreground="#7A8FA3" TextWrapping="Wrap"/>
                        </StackPanel>
                      </Border>
                    </StackPanel>
                  </ScrollViewer>
                  <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="10">
                      <Border Background="White" CornerRadius="10" Padding="14">
                        <StackPanel Spacing="8">
                          <TextBlock Text="当前通道实际图像（Core 已验证 PNG）" FontSize="16"
                                     FontWeight="SemiBold" Foreground="#1E4263"/>
                          <TextBlock Text="{Binding OfflineProduct.SelectedChannel.Display}" FontSize="11"
                                     Foreground="#587187"/>
                          <Border Background="#122D44" CornerRadius="8" Padding="8">
                            <Image Source="{Binding SelectedPreview}" Stretch="Uniform" Height="300"/>
                          </Border>
                          <TextBlock Text="{Binding PreviewNotice}" FontSize="11"
                                     Foreground="#65819A" TextWrapping="Wrap"/>
                          <TextBlock Text="ROI 像素映射只使用这张已验证 PNG 的真实宽高；没有已验证图像时，改变 ROI 的保存会被拒绝。"
                                     FontSize="11" Foreground="#8A6528" TextWrapping="Wrap"/>
                        </StackPanel>
                      </Border>
                      <Border Background="White" CornerRadius="10" Padding="14">
                        <StackPanel Spacing="8">
                          <TextBlock Text="不可变发布 / 激活（严格区分）" FontSize="16"
                                     FontWeight="SemiBold" Foreground="#1E4263"/>
                          <CheckBox IsChecked="{Binding OfflineProduct.PublishConfirmed, Mode=TwoWay}"
                                    Content="我确认发布不可变 Release（不可修改，需重新打开数据库核验）"/>
                          <TextBlock Text="{Binding OfflineProduct.RevisionsSnapshotLabel}" FontSize="10"
                                     Foreground="#6E8297" TextWrapping="Wrap"/>
                          <Button Content="发布不可变 Release（需明确确认）"
                                  Command="{Binding OfflineProduct.PublishCommand}"
                                  HorizontalAlignment="Stretch"/>
                          <Button Content="重新打开 A6 数据库回读 Release"
                                  Command="{Binding OfflineProduct.ReopenPersistedReleaseCommand}"
                                  HorizontalAlignment="Stretch"/>
                          <Border Background="#EAF5EC" CornerRadius="7" Padding="9">
                            <StackPanel Spacing="6">
                              <TextBlock Text="双机安全激活（复用 A6 双节点换型）" FontSize="12"
                                         FontWeight="SemiBold" Foreground="#1D6A3A"/>
                              <CheckBox IsChecked="{Binding OfflineProduct.ActivationConfirmed, Mode=TwoWay}"
                                        Content="我确认激活该 Release（双 Core 必须停止；发布 ≠ 激活）"/>
                              <Button Content="双机安全激活（需明确确认）"
                                      Command="{Binding OfflineProduct.ActivateCommand}"
                                      HorizontalAlignment="Stretch"/>
                              <TextBlock Text="{Binding OfflineProduct.ActivatedRelease}" FontSize="11"
                                         FontFamily="Consolas" TextWrapping="Wrap"/>
                              <TextBlock Text="{Binding OfflineProduct.ActivatedEpoch}" FontSize="11"
                                         TextWrapping="Wrap"/>
                              <TextBlock Text="{Binding OfflineProduct.ActivationProof}" FontSize="10"
                                         Foreground="#4C6B57" TextWrapping="Wrap"/>
                            </StackPanel>
                          </Border>
                          <TextBlock Text="{Binding OfflineProduct.PublishState}" FontSize="12"
                                     FontWeight="SemiBold" Foreground="#1475A1" TextWrapping="Wrap"/>
                          <TextBlock Text="ReleaseId" FontSize="11" FontWeight="SemiBold"/>
                          <TextBlock Text="{Binding OfflineProduct.PublishedRelease}" FontSize="12"
                                     FontFamily="Consolas" TextWrapping="Wrap"/>
                          <TextBlock Text="完整 SHA256（A6 数据库回读）" FontSize="11" FontWeight="SemiBold"/>
                          <TextBlock Text="{Binding OfflineProduct.PublishedSha}" FontSize="11"
                                     FontFamily="Consolas" TextWrapping="Wrap"/>
                          <TextBlock Text="{Binding OfflineProduct.ReleaseProvenance}" FontSize="10"
                                     Foreground="#6E8297" TextWrapping="Wrap"/>
                          <Border Background="#FFF0E6" CornerRadius="7" Padding="9">
                            <TextBlock Text="{Binding OfflineProduct.ActivationState}" FontSize="12"
                                       Foreground="#A23D2A" TextWrapping="Wrap"/>
                          </Border>
                          <TextBlock Text="{Binding OfflineProduct.Status}" FontSize="11"
                                     Foreground="#8A6528" TextWrapping="Wrap"/>
                        </StackPanel>
                      </Border>
                    </StackPanel>
                  </ScrollViewer>
                </Grid>
              </TabItem>
            </TabControl>
          </Grid>
        </TabItem>
        <TabItem Header="日报周报">
          <Grid RowDefinitions="Auto,Auto,*" Margin="8" RowSpacing="12">
            <Border Background="White" CornerRadius="10" Padding="17">
              <StackPanel Spacing="9">
                <TextBlock Text="生产统计 · 日报与周报" FontSize="19" FontWeight="SemiBold"
                           Foreground="#1D4364"/>
                <TextBlock Text="Master SQLite WAL 实际记录 · 工件数而非缺陷次数 · 按主机当地日期统计"
                           FontSize="11" Foreground="#6E8297" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding DailyReportText}" FontSize="14" FontWeight="SemiBold"
                           Foreground="#1475A1" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding WeeklyReportText}" FontSize="13"
                           Foreground="#225776" TextWrapping="Wrap"/>
                <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="9">
                  <Button Content="刷新实际生产统计" Command="{Binding RefreshReportsCommand}"/>
                  <Button Grid.Column="1" Content="导出日报、周报与最近工件 CSV"
                          Command="{Binding ExportReportCsvCommand}"/>
                </Grid>
                <TextBlock Text="{Binding ReportStatus}" FontSize="11"
                           Foreground="#607B8E" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
            <Border Grid.Row="1" Background="#E8F2F9" CornerRadius="9" Padding="10">
              <TextBlock Text="良率分母：已完工 GOOD+NG；HOLD 与进行中单列，不混入已完成品良率。历史工件以 WorkpieceId 唯一归档，同条码不合并。导出 CSV 时由系统原生保存对话框选择保存位置与文件名，取消则不会写入任何文件。"
                         Foreground="#526D85" FontSize="11" TextWrapping="Wrap"/>
            </Border>
            <Border Grid.Row="2" Background="White" Padding="14" CornerRadius="10">
              <Grid RowDefinitions="Auto,*" RowSpacing="9">
                <Grid ColumnDefinitions="75,*,90,75,100,110">
                  <TextBlock Text="工件 ID" FontSize="11" FontWeight="Bold"/>
                  <TextBlock Grid.Column="1" Text="条码" FontSize="11" FontWeight="Bold"/>
                  <TextBlock Grid.Column="2" Text="判定" FontSize="11" FontWeight="Bold"/>
                  <TextBlock Grid.Column="3" Text="通道" FontSize="11" FontWeight="Bold"/>
                  <TextBlock Grid.Column="4" Text="时间" FontSize="11" FontWeight="Bold"/>
                  <TextBlock Grid.Column="5" Text="异常原因" FontSize="11" FontWeight="Bold"/>
                </Grid>
                <ListBox Grid.Row="1" ItemsSource="{Binding ReportHistory}"
                         Background="#F5F8FC" BorderThickness="0">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Grid ColumnDefinitions="75,*,90,75,100,110" Margin="8,10">
                        <TextBlock Text="{Binding ShortId}" FontSize="11"
                                   Foreground="#245B80" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" Text="{Binding Barcode}" FontSize="11"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="2" Text="{Binding Verdict}" FontSize="11"
                                   Foreground="#226E96" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="3" Text="{Binding Channels}" FontSize="11"/>
                        <TextBlock Grid.Column="4" Text="{Binding Time}" FontSize="10"/>
                        <TextBlock Grid.Column="5" Text="{Binding Reason}" FontSize="10"
                                   TextTrimming="CharacterEllipsis"/>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Grid>
            </Border>
          </Grid>
        </TabItem>
      </TabControl>
    </Grid>
  </Grid>
</Window>
