<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AOI.Ui.Avalonia.MainWindow"
        Title="AOI Vision Platform | SIM_ONLY" Width="1580" Height="940"
        MinWidth="1150" MinHeight="730" Background="#F2F5FA">
  <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="20" RowSpacing="12">
    <Border Grid.Row="0" CornerRadius="14" Background="#152F4B" Padding="22,16">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="4">
          <TextBlock Text="AOI VISION  /  CONTROL DESK" FontSize="23" FontWeight="Bold" Foreground="White"/>
          <TextBlock Text="{Binding ChannelCount}" FontSize="13" Foreground="#B6CBDD"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="4" HorizontalAlignment="Right">
          <TextBlock Text="{Binding NodeLabel}" FontSize="19" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Right"/>
          <TextBlock Text="{Binding ConnectionState}" FontSize="12" Foreground="#C8E1F6" HorizontalAlignment="Right"/>
        </StackPanel>
      </Grid>
    </Border>
    <Border Grid.Row="1" Background="#E2EAF4" CornerRadius="10" Padding="16,12">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="5">
          <TextBlock Text="{Binding ProductionState}" FontWeight="Bold" Foreground="#24436A" FontSize="15"/>
          <TextBlock Text="{Binding LatestIdentity}" Foreground="#506683" FontSize="12"/>
        </StackPanel>
        <TextBlock Grid.Column="1" Text="{Binding SafetyStatus}" Foreground="#9C392D"
                   FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
      </Grid>
    </Border>
    <Border Grid.Row="2" Background="White" CornerRadius="10" Padding="12">
      <Grid ColumnDefinitions="245,*" ColumnSpacing="16">
        <StackPanel Spacing="5">
          <TextBlock Text="生产统计 / 历史" FontSize="15" FontWeight="SemiBold" Foreground="#1E3F61"/>
          <TextBlock Text="{Binding ProductionCounters}" FontSize="12" Foreground="#1D6895"
                     FontWeight="SemiBold" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding HistoryNote}" FontSize="10" Foreground="#75879B" TextWrapping="Wrap"/>
        </StackPanel>
        <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled" MaxHeight="105">
          <ItemsControl ItemsSource="{Binding RecentWorkpieces}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="8"/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border CornerRadius="7" BorderThickness="1" BorderBrush="#D8E2EE"
                        Background="#F3F7FC" MinWidth="170" Padding="10">
                  <StackPanel Spacing="3">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{Binding ShortId}" FontSize="13" Foreground="#24466B"
                                 FontWeight="Bold"/>
                      <TextBlock Grid.Column="1" Text="{Binding Decision}" Foreground="#2B7390"
                                 FontWeight="SemiBold" FontSize="11"/>
                    </Grid>
                    <TextBlock Text="{Binding Barcode}" Foreground="#576B80" FontSize="11"/>
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{Binding Epoch}" Foreground="#8897AA" FontSize="10"/>
                      <TextBlock Grid.Column="1" Text="{Binding Channels}" Foreground="#526C86" FontSize="10"/>
                    </Grid>
                    <TextBlock Text="{Binding LocalTime}" Foreground="#8897AA" FontSize="10"/>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Border>
    <Grid Grid.Row="3" ColumnDefinitions="1.35*,1*" ColumnSpacing="12">
      <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto" RowSpacing="10">
        <Border Background="White" CornerRadius="10" Padding="14">
          <StackPanel Spacing="4">
            <TextBlock Text="整机设备地图  /  11 通道实时监视" FontSize="16" FontWeight="SemiBold" Foreground="#1E3F61"/>
            <TextBlock Text="设备卡与右侧 PLC 映射表同步选中 · 蓝图坐标/机械动画待数字孪生 IPC 合同"
                       Foreground="#6F8092" FontSize="11" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
        <Border Grid.Row="1" Background="#EAF0F7" CornerRadius="11" Padding="8">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ListBox ItemsSource="{Binding Channels}" SelectedItem="{Binding SelectedChannel, Mode=TwoWay}"
                     Background="Transparent" BorderThickness="0">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border BorderBrush="#C6D5E6" BorderThickness="1" CornerRadius="9"
                          Background="White" Margin="4" Padding="12" MinHeight="133">
                    <StackPanel Spacing="5">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding ChannelId}" FontSize="21" Foreground="#21496C" FontWeight="Bold"/>
                        <TextBlock Grid.Column="1" Text="{Binding Owner}" FontSize="10" Foreground="#8393A8"/>
                      </Grid>
                      <TextBlock Text="{Binding StationDetails}" FontSize="11" TextWrapping="Wrap" Foreground="#526C86"/>
                      <TextBlock Text="{Binding State}" FontSize="12" Foreground="#1C7290" FontWeight="SemiBold"/>
                      <TextBlock Text="{Binding FrameLabel}" FontSize="10" TextWrapping="Wrap" Foreground="#8190A4"/>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </ScrollViewer>
        </Border>
        <Border Grid.Row="2" Background="White" CornerRadius="10" Padding="12">
          <StackPanel Spacing="3">
            <TextBlock Text="整机状态  /  +1 监控" FontWeight="SemiBold" Foreground="#23486B"/>
            <TextBlock Text="{Binding ProductionState}" FontSize="12" Foreground="#55708B"/>
          </StackPanel>
        </Border>
      </Grid>
      <Grid Grid.Column="1" RowDefinitions="1.35*,Auto" RowSpacing="10">
        <TabControl Grid.Row="0" Background="White">
          <TabItem Header="11 路通道监控">
  <Border Background="White" CornerRadius="10" Padding="14">
            <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8">
              <TextBlock Text="PLC / 通道映射 · 只读" FontSize="16" FontWeight="SemiBold" Foreground="#1E3F61"/>
              <Grid Grid.Row="1" ColumnDefinitions="64,80,95,*,88" Margin="9,0">
                <TextBlock Text="通道" FontSize="11" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="1" Text="站点/设备" FontSize="11" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="2" Text="PLC 地址" FontSize="11" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="3" Text="监控状态" FontSize="11" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="4" Text="机台" FontSize="11" FontWeight="SemiBold"/>
              </Grid>
              <ListBox Grid.Row="2" ItemsSource="{Binding Channels}" SelectedItem="{Binding SelectedChannel, Mode=TwoWay}"
                       BorderThickness="0" Background="#F5F8FB">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="64,80,95,*,88" Margin="5,8">
                      <TextBlock Text="{Binding ChannelId}" FontWeight="SemiBold" FontSize="12"/>
                      <TextBlock Grid.Column="1" Text="{Binding Device}" FontSize="10" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Grid.Column="2" Text="{Binding PlcAddress}" FontSize="12"/>
                      <TextBlock Grid.Column="3" Text="{Binding State}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Grid.Column="4" Text="{Binding Owner}" FontSize="10"/>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Border>
          </TabItem>
          <TabItem Header="45 条 PLC 工程映射">
            <Grid RowDefinitions="Auto,Auto,*" Margin="10" RowSpacing="8">
              <TextBlock Text="{Binding EngineeringRegistryState}" TextWrapping="Wrap"
                         FontSize="11" Foreground="#986033"/>
              <Grid Grid.Row="1" ColumnDefinitions="170,100,80,90,90,*" Margin="8,2">
                <TextBlock Text="信号 ID" FontWeight="SemiBold" FontSize="11"/>
                <TextBlock Grid.Column="1" Text="PLC 地址" FontWeight="SemiBold" FontSize="11"/>
                <TextBlock Grid.Column="2" Text="工位" FontWeight="SemiBold" FontSize="11"/>
                <TextBlock Grid.Column="3" Text="主从" FontWeight="SemiBold" FontSize="11"/>
                <TextBlock Grid.Column="4" Text="方向" FontWeight="SemiBold" FontSize="11"/>
                <TextBlock Grid.Column="5" Text="状态 / 功能" FontWeight="SemiBold" FontSize="11"/>
              </Grid>
              <ListBox Grid.Row="2" ItemsSource="{Binding PlcSignals}"
                       SelectedItem="{Binding SelectedPlcSignal, Mode=TwoWay}"
                       Background="#F5F8FB" BorderThickness="0">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="170,100,80,90,90,*" Margin="6,7">
                      <TextBlock Text="{Binding Id}" FontSize="11" FontWeight="SemiBold"
                                 Foreground="#254B6E" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Grid.Column="1" Text="{Binding DmAddress}" FontSize="11"/>
                      <TextBlock Grid.Column="2" Text="{Binding Station}" FontSize="10"/>
                      <TextBlock Grid.Column="3" Text="{Binding Host}" FontSize="10"/>
                      <TextBlock Grid.Column="4" Text="{Binding Direction}" FontSize="10"
                                 TextTrimming="CharacterEllipsis"/>
                      <StackPanel Grid.Column="5" Spacing="2">
                        <TextBlock Text="{Binding Validation}" FontSize="10" Foreground="#A05B2D"/>
                        <TextBlock Text="{Binding Purpose}" FontSize="11"
                                   TextWrapping="Wrap" Foreground="#4C647D"/>
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </TabItem>
          <TabItem Header="14 项现场验证门禁">
            <Grid RowDefinitions="Auto,*" Margin="10" RowSpacing="8">
              <TextBlock Text="工程证据：7 项 BLOCKED / 7 项 OPEN。全部禁止真实 PLC 写入；OPEN 不代表通过。"
                         Foreground="#923D31" FontSize="11" TextWrapping="Wrap"/>
              <ListBox Grid.Row="1" ItemsSource="{Binding PlcGates}"
                       SelectedItem="{Binding SelectedFieldGate, Mode=TwoWay}"
                       BorderThickness="0" Background="#F6F8FB">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Border Margin="3" Padding="9" CornerRadius="7"
                            Background="White" BorderBrush="#DAE2EB" BorderThickness="1">
                      <StackPanel Spacing="4">
                        <Grid ColumnDefinitions="80,*,85">
                          <TextBlock Text="{Binding GateId}" FontWeight="Bold" FontSize="12"/>
                          <TextBlock Grid.Column="1" Text="{Binding Topic}" FontSize="12"
                                     TextWrapping="Wrap"/>
                          <TextBlock Grid.Column="2" Text="{Binding Status}" FontSize="11"
                                     Foreground="#A44532" FontWeight="SemiBold"/>
                        </Grid>
                        <TextBlock Text="{Binding RequiredEvidence}" FontSize="11"
                                   Foreground="#516B85" TextWrapping="Wrap"/>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </TabItem>
          <TabItem Header="HOLD / 异常">
            <Grid Margin="10" RowDefinitions="Auto,*" RowSpacing="8">
              <Border Background="#FFF2EA" CornerRadius="7" Padding="12">
                <StackPanel Spacing="4">
                  <TextBlock Text="工件隔离 / 出料禁止" Foreground="#A44130" FontSize="15" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding HoldNotice}" Foreground="#8C513B" TextWrapping="Wrap" FontSize="12"/>
                  <TextBlock Text="此记录由 Core SQLite WAL 提供；HOLD 不等于 NG，必须经人工复核。未提供清除或硬件放行按钮。"
                             Foreground="#6C7783" TextWrapping="Wrap" FontSize="11"/>
                </StackPanel>
              </Border>
              <ListBox Grid.Row="1" ItemsSource="{Binding HeldWorkpieces}"
                       BorderThickness="0" Background="#F5F7FA">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Border Margin="3,4" Padding="11" CornerRadius="8" Background="White"
                            BorderBrush="#F0CABF" BorderThickness="1">
                      <StackPanel Spacing="4">
                        <Grid ColumnDefinitions="*,110">
                          <TextBlock Text="{Binding ReasonCode}" FontWeight="Bold" FontSize="13" Foreground="#A33D30"/>
                          <TextBlock Grid.Column="1" Text="{Binding ShortId}" FontSize="11" Foreground="#58718B"/>
                        </Grid>
                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="#52667A" FontSize="12"/>
                        <TextBlock Text="{Binding RaisedUtc}" Foreground="#72869B" FontSize="11"/>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </TabItem>
          <TabItem Header="产品方案 / 换型">
            <Grid Margin="10" RowDefinitions="Auto,Auto,*" RowSpacing="8">
              <Border Padding="12" Background="#EAF4F7" CornerRadius="8">
                <StackPanel Spacing="5">
                  <TextBlock Text="{Binding ActiveProductLabel}" FontSize="14"
                             FontWeight="SemiBold" Foreground="#1C4D75" TextWrapping="Wrap"/>
                  <TextBlock Text="{Binding ActiveProductRelease}" FontSize="11"
                             Foreground="#41708F" TextWrapping="Wrap"/>
                  <TextBlock Text="方案由 A6 离线版本库发布、双机哈希读回后在 SIM_FULL 中使用；A6 SafeHold 不会自动解除，REAL 硬件不可操作。"
                             Foreground="#6D768A" FontSize="11" TextWrapping="Wrap"/>
                </StackPanel>
              </Border>
              <Grid Grid.Row="1" ColumnDefinitions="95,*,85,105" Margin="10,2">
                <TextBlock Text="工位" FontSize="11" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="1" Text="逻辑通道" FontSize="11" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="2" Text="亮度阈值" FontSize="11" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="3" Text="最小亮区比例" FontSize="11" FontWeight="SemiBold"/>
              </Grid>
              <ListBox Grid.Row="2" ItemsSource="{Binding ProductStations}"
                       BorderThickness="0" Background="#F5F8FB">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="95,*,85,105" Margin="9,8">
                      <TextBlock Text="{Binding StationId}" FontWeight="SemiBold"
                                 FontSize="12" Foreground="#2B557B"/>
                      <TextBlock Grid.Column="1" Text="{Binding Channels}" FontSize="11"
                                 Foreground="#506983" TextWrapping="Wrap"/>
                      <TextBlock Grid.Column="2" Text="{Binding BrightThreshold}" FontSize="12"/>
                      <TextBlock Grid.Column="3" Text="{Binding MinimumBrightFraction}" FontSize="12"/>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </TabItem>
        </TabControl>
        <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="14">
          <StackPanel Spacing="9">
            <TextBlock Text="通道图像预览 / ROI 归一化草稿" FontSize="16" FontWeight="SemiBold" Foreground="#1E3F61"/>
            <TextBlock Text="{Binding SelectedDescription}" FontSize="12" TextWrapping="Wrap" Foreground="#526C86"/>
            <Border Background="#EAF0F7" BorderThickness="1" BorderBrush="#CFDBE8"
                    CornerRadius="7" Padding="8">
              <StackPanel Spacing="4">
                <Image Source="{Binding SelectedPreview}" Stretch="Uniform" Height="125"/>
                <TextBlock Text="{Binding PreviewNotice}" FontSize="10" Foreground="#58728F"
                           TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="9">
              <StackPanel><TextBlock Text="X" FontSize="11"/><TextBox Text="{Binding RoiX}"/></StackPanel>
              <StackPanel Grid.Column="1"><TextBlock Text="Y" FontSize="11"/><TextBox Text="{Binding RoiY}"/></StackPanel>
              <StackPanel Grid.Column="2"><TextBlock Text="宽" FontSize="11"/><TextBox Text="{Binding RoiWidth}"/></StackPanel>
              <StackPanel Grid.Column="3"><TextBlock Text="高" FontSize="11"/><TextBox Text="{Binding RoiHeight}"/></StackPanel>
            </Grid>
            <Button Content="验证本地 ROI 草稿（不保存、不下发）" Command="{Binding ValidateRoiCommand}"
                    HorizontalAlignment="Stretch"/>
            <TextBlock Text="{Binding RoiFeedback}" FontSize="12" Foreground="#7D5C2C" TextWrapping="Wrap"/>
            <TextBlock Text="历史与统计来自 Core WAL；方案发布、报警操作和现场硬件编辑仍未授权。"
                       TextWrapping="Wrap" FontSize="11" Foreground="#738497"/>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</Window>
